# =============================================================================
# ProjectView - environment configuration
# Copy this file to ".env" in the project root and adjust the values.
# docker-compose.yml automatically loads ".env" for the backend service.
# =============================================================================

# --- PostgreSQL (configurable) -------------------------------------------
# Full connection string. Point this at any PostgreSQL instance (the bundled
# container, RDS, Cloud SQL, on-prem, ...). The schema is created automatically
# on first boot by the migrations embedded in the backend binary.
DATABASE_URL=postgres://projectview:projectview@postgres:5432/projectview?sslmode=disable
# Size of the connection pool.
DATABASE_MAX_CONNS=10

# --- JWT / sessions -------------------------------------------------------
JWT_SECRET=please-change-this-to-a-long-random-string
# Access-token lifetime. Kept short because revocation is checked against the
# session record on every request; a short window bounds the damage anyway.
JWT_EXPIRES_IN_HOURS=8
# How long a login survives without re-entering credentials. The refresh token
# is rotated on every use.
SESSION_REFRESH_DAYS=30

# --- Logging ----------------------------------------------------------------
# json | text. Empty picks json in production and text elsewhere.
LOG_FORMAT=
LOG_LEVEL=info

# --- Active Directory / LDAP login ----------------------------------------
# Set AD_ENABLED=true to require/allow login against your corporate AD.
AD_ENABLED=false
AD_URL=ldap://dc.example.com:389
AD_BASE_DN=dc=example,dc=com
AD_DOMAIN=example.com
# Optional service account used to look up a user's DN before binding as
# them. If left blank, the app binds directly as "<user>@AD_DOMAIN".
AD_BIND_DN=
AD_BIND_PASSWORD=
AD_USERNAME_ATTRIBUTE=sAMAccountName
AD_TLS_REJECT_UNAUTHORIZED=true

# --- Internal e-mail integration (SMTP) ------------------------------------
# Point this at your internal mail relay/Exchange/SMTP server.
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ProjectView <no-reply@example.com>"

# --- Deadline alert scheduler ----------------------------------------------
# Standard 5-field cron expression for how often the app scans for tasks due
# soon/overdue.
ALERT_CRON=0 * * * *
# How many days before the due date a "coming due" alert fires.
ALERT_WARN_DAYS_BEFORE=2

# --- Default admin bootstrap ------------------------------------------------
# The first administrator, created only when the database has no users at all.
# On an installation that has already been seeded these are ignored, so change
# the password here BEFORE the first start - or afterwards from
# Administration -> Users, which also ends every session the account has open.
#
# This password is published in the repository. Treat it as known.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# --- Edge proxy / HTTPS ----------------------------------------------------
# The "proxy" container terminates TLS and is the only service published to
# the host. Put your certificate in proxy/certs/ as fullchain.pem +
# privkey.pem; if it is missing, a self-signed cert is generated for
# TLS_COMMON_NAME so the stack still starts.
TLS_COMMON_NAME=localhost
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# --- Misc --------------------------------------------------------------
CORS_ORIGIN=*
PORT=4000
NODE_ENV=production

# --- Single sign-on (OpenID Connect) ---------------------------------------
# Works with any compliant provider. Endpoints are discovered from the issuer,
# so a provider that moves them does not require a redeploy.
OIDC_ENABLED=false
# OIDC_ISSUER_URL=https://login.microsoftonline.com/<tenant>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Register this with the provider exactly as written; a redirect URI mismatch
# is the most common cause of a failed first setup.
# OIDC_REDIRECT_URL=https://localhost/api/auth/oidc/callback
# OIDC_SCOPES=openid profile email
# Off deliberately: with it on, anyone the identity provider will authenticate
# has an account here, which is a wider door than most organisations intend.
# OIDC_AUTO_PROVISION=false

# --- Model (OpenAI-compatible) ----------------------------------------------
# Optional. With it off, everything works exactly as before: the suggestions
# simply do not appear.
#
# Any server speaking the OpenAI chat-completions API fits here - the hosted
# providers, vLLM, Ollama, llama.cpp, LM Studio, OpenRouter - because the wire
# format is the same one. Which of those an installation uses is a deployment
# decision, and for a tool holding a company's work a governance one, so it is
# configuration rather than code.
AI_ENABLED=false
# The address, as you would say it. The protocol and the /v1 path are filled in
# if you leave them out: an address on a private range is assumed to be http,
# anything else https. All of these are accepted and mean the same thing:
#   AI_ENDPOINT=192.168.1.50:8000
#   AI_ENDPOINT=http://192.168.1.50:8000/v1
#   AI_ENDPOINT=ollama:11434
#   AI_ENDPOINT=api.openai.com
# A path you supply is left alone, which is what Azure OpenAI needs:
#   AI_ENDPOINT=https://<resource>.openai.azure.com/openai/deployments/<name>
# AI_ENDPOINT=
# Usually empty for a model on your own network; required by hosted providers.
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_TIMEOUT_SECONDS=30

# --- Retention --------------------------------------------------------------
# Both windows are 0 by default, which keeps everything. Deleting records
# because a config file was left empty is what a retention policy exists to
# prevent. Read notifications only; unread ones are never expired.
AUDIT_RETENTION_DAYS=0
NOTIFICATION_RETENTION_DAYS=0
# RETENTION_CRON=30 3 * * *

# --- Settings mirror ---------------------------------------------------------
# Administrators can change the AD, SMTP, SSO, model, alert and retention settings
# from the application. Those overrides live in PostgreSQL and apply without a
# restart; this file is the mirror written alongside them, for backup and
# review. Leave empty to switch mirroring off.
SETTINGS_ENV_FILE=/config/app.env

# --- Attachments / object storage ------------------------------------------
# Files attached to tasks and comments are kept in an S3-compatible object
# store, never in PostgreSQL. The bundled stack runs MinIO; point these at
# Amazon S3 or any equivalent to use one instead. Leave STORAGE_BUCKET empty to
# switch attachments off entirely - the rest of the application is unaffected
# and the upload controls disappear.
#
# Two addresses, deliberately. STORAGE_ENDPOINT is what the backend calls;
# STORAGE_PUBLIC_URL is where the browser is sent. A download link is signed
# for the host that will receive it, so signing for "minio:9000" and fetching
# from "localhost" fails verification - which is the usual cause of a download
# that returns SignatureDoesNotMatch.
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_URL=https://localhost
# The proxy routes this path to the object store, so changing the bucket name
# means changing the matching "location" block in proxy/nginx.conf.
STORAGE_BUCKET=attachments
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=projectview
STORAGE_SECRET_KEY=projectview-storage
# Path-style addressing (endpoint/bucket/key). Required by MinIO; also the
# right answer for any endpoint that is an IP address. Amazon S3 accepts it.
STORAGE_FORCE_PATH_STYLE=true
# How long a signed download link stays valid. Short enough that a link pasted
# into a chat expires before it circulates.
STORAGE_URL_TTL_MINUTES=15

# Per-file and per-task ceilings. The per-file limit must stay below the
# proxy's client_max_body_size (30m), so an oversized upload is refused by the
# application - with a message naming the limit - rather than by nginx.
ATTACHMENT_MAX_MB=25
ATTACHMENT_MAX_TASK_MB=250
# Optional MIME allow-list, comma-separated, exact or wildcard
# ("application/pdf,image/*"). Empty allows anything except the executable
# formats the application refuses outright. A list nobody maintains is the
# reason people go back to e-mailing files around, so the default is empty.
ATTACHMENT_ALLOWED_TYPES=

# --- PostgreSQL container credentials --------------------------------------
# Used to initialise the bundled postgres container. Keep them in sync with
# DATABASE_URL above, and change them for anything beyond a local run.
POSTGRES_USER=projectview
POSTGRES_PASSWORD=projectview
POSTGRES_DB=projectview
# Host port for psql/pgAdmin inspection (bound to 127.0.0.1 only).
# POSTGRES_PORT=5432
